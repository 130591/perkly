<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Você recebeu um pagamento</title>
  </head>
  <body style="margin:0; padding:0; background-color:#f4f4f6; font-family:'Plus Jakarta Sans', -apple-system, Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f6;">
      <tr>
        <td align="center" style="padding:40px 20px;">
          <table role="presentation" width="420" cellpadding="0" cellspacing="0" style="max-width:420px; width:100%; background-color:#ffffff; border:1px solid #e6e6ea; border-radius:18px;">
            <tr>
              <td style="padding:32px;">

                <table role="presentation" cellpadding="0" cellspacing="0" style="margin-bottom:30px;">
                  <tr>
                    <td style="width:12px; height:12px; border-radius:3px; background-color:#129a5e; font-size:0; line-height:0;">&nbsp;</td>
                    <td style="padding-left:9px; font-family:'JetBrains Mono', monospace; font-weight:600; font-size:18px; letter-spacing:-0.04em; color:#1c1d22;">perkly</td>
                  </tr>
                </table>

                <div style="font-size:15px; color:#5f6068; margin-bottom:4px;">Você recebeu</div>
                <div style="font-family:'JetBrains Mono', monospace; font-size:42px; font-weight:600; letter-spacing:-0.03em; line-height:1; color:#1c1d22; margin-bottom:18px;">{{amount}}</div>

                <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; background-color:#fbf6ea; border:1px solid #efe1c4; border-radius:12px; margin-bottom:18px;">
                  <tr>
                    <td style="padding:11px 14px; font-size:13px; font-weight:600; color:#9a6406;">
                      <span style="display:inline-block; width:7px; height:7px; border-radius:50%; background-color:#d68a0c; margin-right:8px;">&nbsp;</span>
                      Resgate até {{expiresAt}}
                    </td>
                  </tr>
                </table>

                <table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; margin-bottom:26px;">
                  <tr><td style="padding:4px 0; font-size:13px; color:#5f6068;">&bull; Pagamento via PIX &middot; cai na hora</td></tr>
                  <tr><td style="padding:4px 0; font-size:13px; color:#5f6068;">&bull; Link exclusivo e de uso único</td></tr>
                  <tr><td style="padding:4px 0; font-size:13px; color:#5f6068;">&bull; Processado com segurança pela Perkly</td></tr>
                </table>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center" style="background-color:#129a5e; border-radius:14px;">
                      <a href="{{link}}" style="display:block; padding:17px 0; font-size:16px; font-weight:600; color:#ffffff; text-decoration:none;">Resgatar</a>
                    </td>
                  </tr>
                </table>

                <div style="text-align:center; font-size:12px; color:#9a9ba1; margin-top:14px;">Sem cadastro, senha ou aplicativo.</div>

              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
